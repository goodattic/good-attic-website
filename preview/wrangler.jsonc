{
  "name": "good-attic-lp-rc",
  "main": "worker.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PREVIEW_SUBMISSIONS_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "PREVIEW_DB",
      "database_name": "good-attic-lp-rc-isolated",
      "database_id": "ba7adf8a-dfee-41ff-b6fd-c2e5882c2118"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.js.txt"
      ],
      "fallthrough": true
    }
  ]
}
